# Jemsamediatech Environment Variables
# Copy this to .env.local and fill in real values

# Contact Form - Resend/SMTP (TODO: Integrate real email service)
RESEND_API_KEY=your_resend_api_key_here
CONTACT_EMAIL=hello@jemsamediatech.com

# Google Maps Embed API (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Supabase CMS
# Public browser values only. Never put the service role key in frontend files.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
